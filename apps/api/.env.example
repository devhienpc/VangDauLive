# File này chỉ là EXAMPLE cho local development (.dev.vars cho Cloudflare Workers)
# KHÔNG commit file .dev.vars hay file .env thật vào git

# API Key từ eia.gov (US Energy Information Administration)
EIA_API_KEY=your_eia_api_key_here

# API Key từ metalpriceapi.com (Vàng, Bạc)
METALS_API_KEY=your_metals_api_key_here

# API Key từ exchangerate-api.com (Ngoại tệ - nếu có)
EXCHANGE_API_KEY=your_exchange_api_key_here
