{
  "name": "api",
  "version": "1.0.0",
  "type": "module",
  "private": true,

  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/**/*.test.js",
    "lint": "eslint src --ext .ts",

    "db:migrate:local": "wrangler d1 migrations apply vangdau-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply vangdau-db --remote",
    "db:seed:local": "wrangler d1 execute vangdau-db --local --file=seed.sql",
    "db:seed:remote": "wrangler d1 execute vangdau-db --remote --file=seed.sql",
    "db:setup:local": "npm run db:migrate:local && npm run db:seed:local",
    "db:backfill:local": "curl.exe -s -X POST http://localhost:8787/api/admin/backfill -H \"X-Admin-Key: hiendz123\""
  },
  "dependencies": {
    "hono": "^4.5.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240924.0",
    "typescript": "^5.5.3",
    "wrangler": "^3.75.0"
  }
}
